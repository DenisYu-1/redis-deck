#!/usr/bin/env node
// A fake agent CLI. FAKE_AGENT holds its script:
// { record: file, steps: [{ say } | { call: { name, args } } | { fail, stderr }
//   | { hang: true }] }
// It writes down what it was started with and what its calls got back.
const fs = require('fs');
const { Client } = require('@modelcontextprotocol/sdk/client/index.js');
const {
    StreamableHTTPClientTransport
} = require('@modelcontextprotocol/sdk/client/streamableHttp.js');

const script = JSON.parse(process.env.FAKE_AGENT);
const argv = process.argv.slice(2);
const configPath = argv[argv.indexOf('--mcp-config') + 1];
const record = {
    pid: process.pid,
    argv,
    cwd: process.cwd(),
    env: {
        attachmentsOff: process.env.CLAUDE_CODE_DISABLE_ATTACHMENTS,
        idleTimeout: process.env.CLAUDE_CODE_MCP_TOOL_IDLE_TIMEOUT
    },
    stdin: '',
    results: []
};
const save = () => fs.writeFileSync(script.record, JSON.stringify(record));

async function main() {
    for await (const chunk of process.stdin) record.stdin += chunk;
    record.config = JSON.parse(fs.readFileSync(configPath, 'utf8'));
    record.configMode = fs.statSync(configPath).mode & 0o777;
    save();

    const server = record.config.mcpServers['redis-deck'];
    const client = new Client({ name: 'claude-code', version: '0.0.0' });
    await client.connect(
        new StreamableHTTPClientTransport(new URL(server.url), {
            requestInit: { headers: server.headers }
        })
    );
    record.tools = (await client.listTools()).tools.map((t) => t.name);
    save();

    for (const step of script.steps) {
        if (step.say) process.stdout.write(step.say);
        if (step.call) {
            const result = await client.callTool(
                { name: step.call.name, arguments: step.call.args },
                undefined,
                { timeout: 60_000 }
            );
            record.results.push({
                isError: Boolean(result.isError),
                text: result.content[0].text
            });
            save();
        }
        if (step.fail) {
            process.stderr.write(step.stderr ?? '');
            process.exit(step.fail);
        }
        if (step.hang) await new Promise(() => setInterval(() => {}, 1000));
    }
    await client.close();
}

main().catch((error) => {
    process.stderr.write(`fake agent: ${error.message}`);
    process.exit(9);
});
