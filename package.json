{
    "name": "redis-deck",
    "version": "1.0.0",
    "description": "A UI for Redis cluster that uses redis-cli under the hood",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "dev": "concurrently \"vite\" \"nodemon server.js\"",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "start": "node server.js",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "lint:fix": "eslint . --ext ts,tsx --fix && prettier --write .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "jest",
        "test:watch": "jest --watch",
        "type-check": "tsc --noEmit",
        "electron:dev": "ELECTRON_DEV=1 electron .",
        "electron:build": "yarn build && bash scripts/build-redis-cli.sh && electron-builder",
        "electron:smoke": "node scripts/smoke-packaged.js"
    },
    "dependencies": {
        "@alenaksu/json-viewer": "^2.1.2",
        "better-sqlite3": "^13.0.3",
        "chart.js": "^4.6.1",
        "dotenv": "^18.0.10",
        "express": "^5.3.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^7.18.5",
        "react-window": "^2.5.3",
        "redis": "^6.3.1",
        "zustand": "^5.1.0"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.1.5",
        "@testing-library/react": "^15.0.7",
        "@testing-library/user-event": "^14.6.8",
        "@types/better-sqlite3": "^9.6.0",
        "@types/express": "^5.0.3",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.6.6",
        "@types/react": "^18.3.11",
        "@types/react-dom": "^18.3.1",
        "@types/react-router-dom": "^5.3.3",
        "@typescript-eslint/eslint-plugin": "^7.0.1",
        "@typescript-eslint/parser": "^7.0.1",
        "@vitejs/plugin-react": "^6.2.1",
        "concurrently": "^10.0.7",
        "electron": "^45.3.1",
        "electron-builder": "^26.18.0",
        "eslint": "^8.56.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-react": "^7.37.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.4.12",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "nodemon": "^3.0.1",
        "prettier": "^3.9.10",
        "supertest": "^7.3.2",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "vite": "^8.3.6",
        "vite-plugin-svgr": "^5.2.0"
    },
    "main": "electron/main.js"
}
